{
  "manifest_version": 3,
  "name": "Fakt",
  "version": "0.2.0",
  "description": "See how likely a post is to be true, graded against the evidence.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "sidePanel", "contextMenus", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "action": {
    "default_title": "Open Fakt",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "ui/index.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "check-post": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Check the post in view"
    }
  }
}
