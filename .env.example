# Export these in your shell. Only the Claude Code CLI login is required; each key
# below adds a source, and a missing key skips that source with a warning.
TYPESAFE_API_KEY=     # Jev grades each source quickly. Without it Claude does the grading.
EXA_API_KEY=          # web, news and paper search
SERPER_API_KEY=       # Google results for niche pages
GROQ_API_KEY=         # transcribes reels and videos without captions
APIFY_TOKEN=          # fallback for social posts yt-dlp cannot read
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
FAKT_SPEND_CAP_USD=40 # hard stop on estimated spend across paid services
FAKT_CONTACT_EMAIL=   # optional, sent to OpenAlex and Crossref as a courtesy
